{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rootDir": "../",
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@shared/types": ["../shared/types.ts"],
      "@shared/validators": ["../shared/validators.ts"],
    }
  },
  "include": ["src/**/*", "../shared/**/*"]
}
