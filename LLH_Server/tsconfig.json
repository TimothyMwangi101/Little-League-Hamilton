{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rootDir": "../",
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
  },
  "include": ["src/**/*", "../shared/**/*"]
}
