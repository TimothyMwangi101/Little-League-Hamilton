    {
      "value": "\"challengerId\" <> \"opponentId\"",
      "name": "no dups",
      "entityType": "checks",
      "table": "matches"
    },
    {
      "value": "\"challengerScore\" >= 0 AND \"opponentScore\" >= 0",
      "name": "matches_scores_non_negative",
      "entityType": "checks",
      "table": "matches"
    },
    {
      "value": "\"status\" <> 'Completed' OR (\"challengerScore\" IS NOT NULL AND \"opponentScore\" IS NOT NULL)",
      "name": "matches_completed_has_scores",
      "entityType": "checks",
      "table": "matches"
    },
    {
      "value": "\"goals\" >= 0 AND \"assists\" >= 0",
      "name": "match_players_non_negative",
      "entityType": "checks",
      "table": "match_players"
    },
    {
      "definition": "\n  SELECT\n    t.id AS teamId,\n    COALESCE(SUM(r.win), 0)  AS wins,\n    COALESCE(SUM(r.loss), 0) AS losses,\n    COALESCE(SUM(r.draw), 0) AS draws\n  FROM teams t\n  LEFT JOIN (\n    SELECT \n      challengerId AS teamId,\n      challengerScore > opponentScore AS win,\n      challengerScore < opponentScore AS loss,\n      challengerScore = opponentScore AS draw\n    FROM matches WHERE status = 'Completed'\n    UNION ALL\n    SELECT \n      opponentId,\n      opponentScore > challengerScore,\n      opponentScore < challengerScore,\n      opponentScore = challengerScore\n    FROM matches WHERE status = 'Completed'\n  ) r ON r.teamId = t.id\n  GROUP BY t.id;",
      "isExisting": false,
      "error": null,
      "name": "team_records",
      "entityType": "views"
    }
  ],
