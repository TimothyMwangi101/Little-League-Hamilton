{
    "name": "llh",
    "workspaces": [
        "LLH_Server",
        "LLH_UI"
    ],
    "scripts": {
        "dev:ui": "npm run dev --workspace=LLH_UI",
        "dev:server": "npm run dev --workspace=LLH_Server",

        "build:ui": "npm run build --workspace=LLH_UI",
        "build:server": "npm run build --workspace=LLH_Server",

        "lint:ui": "npm run lint --workspace=LLH_UI",
        "lint:server": "npm run lint --workspace=LLH_Server",

        "build": "npm run build:server && npm run build:ui",
        "lint": "npm run lint:server && npm run lint:ui"
    }
}